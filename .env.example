# ── MongoDB ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=phantom_trade

# ── LLMs ─────────────────────────────────────────────────────────────────
# Primary: Gemini (recommended for this project)
GEMINI_API_KEY=your_google_ai_studio_key_here

# Fallback: Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-xxx

# ── AWS ──────────────────────────────────────────────────────────────────
# S3 artifact storage (non-blocking — system works without this)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=phantom-trade-artifacts

# Disable Bedrock if you haven't requested Anthropic model access on Bedrock
DISABLE_BEDROCK=true

# ── Embeddings ───────────────────────────────────────────────────────────
VOYAGE_API_KEY=al-your_voyage_ai_key

# ── News & Search ─────────────────────────────────────────────────────────
# Tavily API key — get one free at https://app.tavily.com
# IMPORTANT: key starts with "tvly-" not "BSA-"
TAVILY_API_KEY=tvly-dev-your_tavily_key_here
BRAVE_API_KEY=

# ── Social Tracking ──────────────────────────────────────────────────────
# X (Twitter) API v2 Bearer Token (optional — synthetic variants used as fallback)
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LangSmith Observability ───────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key
LANGCHAIN_PROJECT=phantom-trade
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── App Config ────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_RETRIES=3

# ── Risk Thresholds ───────────────────────────────────────────────────────
ALERT_THRESHOLD=15       # Minimum risk delta to trigger Oracle update
CRITICAL_THRESHOLD=80    # Risk level that requires HITL review
SIMILARITY_THRESHOLD=0.75
DECAY_RATE=0.98
DECAY_FLOOR=0.3
